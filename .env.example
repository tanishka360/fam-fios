# Copy to .env on the server (same folder as docker-compose.yml) and fill in.
# .env is git-ignored, so these values never reach GitHub.

# --- Email OTP delivery (Gmail) ---
# SMTP_USER: the Gmail address that sends the codes
# SMTP_PASSWORD: a 16-character Google App Password (Google Account > Security >
#   2-Step Verification > App passwords), written WITHOUT spaces
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- AWS (optional) ---
# AWS_DEFAULT_REGION=us-east-1
# SNS_SMS_SENDER_ID=
# SNS_SMS_ENTITY_ID=
# SNS_SMS_TEMPLATE_ID=
